# 3D PrintSim Pro Environment Variables Example

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Google Gemini AI Key (Optional - for AI Defect Predictor & Auto-Tuner)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Cloud Hub (Optional - for Cloud Storage & Telemetry Sync)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_AUTO_SYNC=false

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
